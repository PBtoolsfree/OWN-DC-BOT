# ========================================
# PB HERO PERSONAL DISCORD BOT
# Environment Configuration
# ========================================
# ⚠️ SECURITY WARNING:
# NEVER commit this file to Git!
# NEVER share your Discord Bot Token!
# NEVER share your dashboard password!
# ========================================

# Discord Configuration
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=

# Dashboard Authentication
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=

# Dashboard Server
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8000

# Session Security
SESSION_SECRET=

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/pbhero.db

# YouTube Monitoring
YOUTUBE_POLL_INTERVAL=60
YOUTUBE_LIVE_CHECK_INTERVAL=30

# Logging
LOG_LEVEL=INFO

# Timezone
TIMEZONE=Asia/Kolkata

# Optional: Dashboard IP Allowlist (comma-separated)
# Examples: 127.0.0.1, 192.168.1.0/24
# DASHBOARD_ALLOWED_IPS=

# Optional: Moderation Log Channel ID
# MOD_LOG_CHANNEL_ID=
